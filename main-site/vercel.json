{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "cleanUrls": true,
    "regions": ["sin1"],
    "rewrites": [{
        "source": "/",
        "destination": "/"
    }],
    "functions": {
        "api/tick.js": {
            "maxDuration": 60
        }
    },
    "crons": [{
        "path": "/api/tick",
        "schedule": "* * * * *"
    }]
}
