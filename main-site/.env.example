# Environment for the functions in api/. On Vercel these are set in the
# project's settings (see PUSH-SETUP.md). For local testing, `npx vercel env
# pull .env.local` fills them in, or copy this file to .env.local and fill it
# in by hand. Never commit .env.local.

# Upstash Redis. Set by the Vercel Marketplace integration when the database
# is connected to the project. UPSTASH_REDIS_REST_URL and
# UPSTASH_REDIS_REST_TOKEN also work, for a database made on upstash.com.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# From `npm run vapid`. Generate once and keep them: new keys invalidate
# every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# How push services can reach you if something goes wrong. mailto: or https:.
VAPID_SUBJECT=mailto:you@example.com

# Vercel sends this with each cron call, and api/tick.js refuses calls
# without it. Any long random string:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CRON_SECRET=
